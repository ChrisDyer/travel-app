# Copy this file to .env.local and fill in the values.
# See README.md for step-by-step setup instructions.

# The base URL of this app (no trailing slash)
# Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: replace with your actual domain
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Google Maps JavaScript API + Places API
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Required APIs: Maps JavaScript API, Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic API key for the AI Trip Assistant
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google OAuth credentials for Gmail scanning
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/gmail/callback
# Gmail label to scan: "Trip Bookings" (create this label in Gmail)
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Shared secret so the homepage dashboard can read /api/summary over localhost
# (server-to-server, bypassing Cloudflare Access). Must match INTERNAL_API_TOKEN in the
# homepage .env. Only enforced in production.
INTERNAL_API_TOKEN=

# Currency the trip cost summary converts foreign totals into when a trip has no budget
# currency set (FX rates via open.er-api.com, no key). Defaults to USD.
NEXT_PUBLIC_HOME_CURRENCY=USD

# Per-user read-only role (production only). Comma-separated, case-insensitive email
# allowlist; any other authenticated Cloudflare Access email is read-only (403 on
# writes + hidden controls). Unset/empty = everyone has full access (fail-open).
ADMIN_EMAILS=
